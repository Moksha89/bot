# Capital.com API Configuration
CAPITAL_API_KEY=your_api_key_here
CAPITAL_EMAIL=your_email@example.com
CAPITAL_PASSWORD=your_password_here
CAPITAL_API_URL=https://demo-api-capital.backend-capital.com
# Use https://api-capital.backend-capital.com for live trading

# Trading Configuration
TRADING_SYMBOL=XAUUSD
TRADING_TIMEFRAME=HOUR
TRADING_MODE=demo
# Options: analysis, paper, demo, live

# Strategy Parameters
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
RSI_BUY_MIN=55
RSI_BUY_MAX=70
RSI_SELL_MIN=30
RSI_SELL_MAX=45
MAX_SPREAD=5.0

# Risk Management
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.05
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_MINUTES=30
MAX_OPEN_TRADES=1
SL_ATR_MULTIPLIER=1.5
TP_RISK_REWARD=2.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./trading_bot.db

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Kill Switch
KILL_SWITCH=false
